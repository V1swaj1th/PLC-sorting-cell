<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_cell_controller</name>
  <version>0.1.0</version>
  <description>UR5e kinematics (FK, geometric Jacobian, damped least-squares IK), Cartesian planner, pick-and-place sequencer, scene server, Modbus PLC bridge, servo drive node and teach pendant</description>
  <maintainer email="viswajithmanthripragada44@gmail.com">Viswajith</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>libmodbus-dev</depend>
  <depend>servo_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ur_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
