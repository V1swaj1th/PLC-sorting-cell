PROGRAM main
  VAR
    heartbeat : INT AT %QW0 := 0; (* Increments every scan. Read at Modbus holding register 0 to prove the PLC is running. *)
    mb_cmd : INT AT %MW0 := 0; (* Command word written over Modbus at holding register 1024. Non-zero turns the lamp on. *)
    lamp_out : BOOL AT %QX0.0 := FALSE; (* Lit when mb_cmd is above 0. Read at Modbus coil 0. *)
  END_VAR

