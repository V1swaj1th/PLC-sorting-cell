<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_cell_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, RViz configurations and scene files for the sorting cell</description>
  <maintainer email="viswajithmanthripragada44@gmail.com">Viswajith</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sorting_cell_controller</exec_depend>
  <exec_depend>sorting_cell_vision</exec_depend>
  <exec_depend>sorting_cell_dashboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
